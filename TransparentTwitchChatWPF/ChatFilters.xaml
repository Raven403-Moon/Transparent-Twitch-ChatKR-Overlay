<Window x:Class="TransparentTwitchChatWPF.ChatFilters"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TransparentTwitchChatWPF"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:ThemeManager.RequestedTheme="Dark"
        Title="채팅 필터" Height="450" Width="400" WindowStyle="ToolWindow" Topmost="True" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="115"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Grid Grid.Column="0" Background="#121212">
            <ListView Name="lvFilters" FontSize="16" SelectionChanged="lvFilters_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Margin" Value="4"/>
                        <Setter Property="Padding" Value="4"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="사용자 이름" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="차단할 이름" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="단어" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
            </ListView>
        </Grid>

        <Grid Name="filterUsernamesGrid" Visibility="Visible" Background="#222" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="27*"/>
                <ColumnDefinition Width="265*"/>
            </Grid.ColumnDefinitions>

            <CheckBox 
                Name="cbAllowedUsers"
                Content="허용된 사용자 이름만 필터링"
                Checked="cbAllowedUsers_Checked"
                Unchecked="cbAllowedUsers_Unchecked"
                HorizontalAlignment="Left" 
                VerticalAlignment="Top"
                Margin="20,10,0,0" Grid.ColumnSpan="2"
                />

            <CheckBox 
                Name="cbHighlightUsers"
                Content="사용자 이름 강조 표시 (필터링 끔)"
                Checked="cbHighlightUsers_Checked"
                Unchecked="cbHighlightUsers_Unchecked"
                HorizontalAlignment="Left" 
                VerticalAlignment="Top"
                Margin="20,37,0,0" Grid.ColumnSpan="2"
                />

            
            <xctk:ColorPicker
                Name="colorPicker" 
                ui:ThemeManager.RequestedTheme="Dark"
                HorizontalAlignment="Left" 
                VerticalAlignment="Top"
                Grid.ColumnSpan="2" 
                Width="200"
                Margin="50,70,0,0" 
                DisplayColorAndName="True" 
                ShowStandardColors="False"
                AvailableColorsSortingMode="HueSaturationBrightness" />

            <CheckBox 
                Name="cbAllMods"
                IsEnabled="false"
                Content="모든 매니저 허용"
                HorizontalAlignment="Left" 
                VerticalAlignment="Top"
                Margin="20,100,0,0" Grid.ColumnSpan="2"
                />

            <xctk:ColorPicker
                Name="colorPickerMods" 
                ui:ThemeManager.RequestedTheme="Dark"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top"
                Grid.ColumnSpan="2" 
                Width="50"
                Margin="0,105,45,0" 
                DisplayColorAndName="False" 
                ShowStandardColors="False"
                AvailableColorsSortingMode="HueSaturationBrightness" />

            <CheckBox 
                Name="cbAllVIPs"
                IsEnabled="false"
                Content="모든 VIP 허용"
                HorizontalAlignment="Left" 
                VerticalAlignment="Top"
                Margin="20,130,0,0" Grid.ColumnSpan="2"
                />

            <xctk:ColorPicker
                Name="colorPickerVIPs" 
                ui:ThemeManager.RequestedTheme="Dark"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top"
                Grid.ColumnSpan="2" 
                Width="50"
                Margin="0,135,45,0" 
                DisplayColorAndName="False" 
                ShowStandardColors="False"
                AvailableColorsSortingMode="HueSaturationBrightness" />

            <ListBox Name="lvAllowedUsernames" 
                     IsEnabled="false"
                      FontSize="12"
                      SelectionMode="Single"
                      Margin="20,205,20,50" Grid.ColumnSpan="2">
            </ListBox>

            <Button Name="btnAddUser"
                IsEnabled="false"
                Content="추가" 
                Height="32"
                HorizontalAlignment="Left" 
                Margin="20,165,0,0"
                VerticalAlignment="Top" 
                Width="75" Grid.ColumnSpan="2" Click="OnClick_AddAllowedUsername" />
            <Button Name="btnRemoveUser"
                IsEnabled="false"
                Content="제거" 
                Height="32"
                HorizontalAlignment="Left" 
                Margin="80,165,0,0"
                VerticalAlignment="Top" 
                Width="75" Grid.Column="1" Click="OnClick_RemoveAllowedUsername" />
        </Grid>

        <Grid Name="filterBotsGrid" Visibility="Hidden" Background="#222" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="27*"/>
                <ColumnDefinition Width="265*"/>
            </Grid.ColumnDefinitions>

            <CheckBox 
                Name="cbBlockBotActivity"
                Content="봇 메시지 차단"
                HorizontalAlignment="Left" 
                VerticalAlignment="Top"
                Margin="20,15,0,0" Grid.ColumnSpan="2"
                />

            <TextBlock
                HorizontalAlignment="Left" 
                VerticalAlignment="Top"
                TextWrapping="Wrap"
                FontSize="11"
                FontStyle="Italic"
                Margin="20,45,0,0" Grid.ColumnSpan="2" Height="64" Width="255" 
                >
                봇 메시지를 자동으로 차단하려고 시도하지만 모든 봇에서 작동하지 않을 수 있습니다.
                봇 메시지가 계속 표시되면 아래 목록에 해당 봇의 이름을 추가하세요.
            </TextBlock>

            <ListBox Name="lvBlockedUsernames" 
                      FontSize="12"
                      SelectionMode="Single"
                      Margin="20,165,20,50" Grid.ColumnSpan="2">
            </ListBox>

            <Button Name="btnAddBlockedUser"
                Content="추가" 
                HorizontalAlignment="Left" 
                Margin="20,125,0,0"
                VerticalAlignment="Top"
                Height="32"
                Width="75" Grid.ColumnSpan="2" Click="OnClick_AddBlockedUsername" />
            <Button Name="btnRemoveBlockedUser"
                Content="제거" 
                HorizontalAlignment="Left" 
                Margin="80,125,0,0"
                VerticalAlignment="Top" 
                Height="32"
                Width="75" Grid.Column="1" Click="OnClick_RemoveBlockedUsername" />
        </Grid>

        <Grid Grid.Column="1">
            <Button
                Name="OKButton"
                Content="확인"
                Height="32"
                HorizontalAlignment="Right" 
                Margin="0,0,93,12"
                VerticalAlignment="Bottom" 
                Width="75" 
                Click="OKButton_Click"
                IsDefault="True" />

            <Button
                Name="CancelButton"
                Content="취소" 
                Height="32" 
                HorizontalAlignment="Right" 
                Margin="0,0,12,12"
                VerticalAlignment="Bottom"
                Width="75" 
                IsCancel="True" />
        </Grid>
    </Grid>
</Window>
