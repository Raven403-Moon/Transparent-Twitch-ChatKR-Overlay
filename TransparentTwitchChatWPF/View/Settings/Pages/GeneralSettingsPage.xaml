<UserControl x:Class="TransparentTwitchChatWPF.View.Settings.GeneralSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TransparentTwitchChatWPF.View.Settings"
             xmlns:ttc="clr-namespace:TransparentTwitchChatWPF"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             ui:ThemeManager.RequestedTheme="Dark"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Name="generalGrid" Visibility="Visible" Grid.Row="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,10,0,20">
                <CheckBox 
                    Name="cbAutoHideBorders"
                    Content="테두리 자동 숨기기"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"
                    Margin="20,5"
                    />
                <CheckBox 
                    Name="cbInteraction"
                    Content="클릭 상호작용 허용 (테두리가 표시될 때)"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"
                    Margin="20,5"
                    />
                <CheckBox 
                    Name="cbCheckForUpdates"
                    Content="업데이트 확인 (매일)"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"
                    Margin="20,5"
                    />
                <Button 
                    Name="btnCheckForUpdatesNow" 
                    Content="지금 업데이트 확인" 
                    Margin="20,5"
                    Click="btnCheckForUpdatesNow_Click"/>
                <CheckBox 
                    Name="cbEnableTrayIcon"
                    Content="트레이 아이콘 표시"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"
                    Margin="20,5,0,0"
                    IsEnabled="false"
                    />
                <Label 
                    FontStyle="Italic"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"
                    Margin="35,0">
                    <Hyperlink NavigateUri = "https://github.com/baffler/Transparent-Twitch-Chat-Overlay/wiki/Using-the-Tray-Icon"
                   Hyperlink.RequestNavigate = "Hyperlink_RequestNavigate" >
                        <TextBlock Text="트레이 아이콘 사용 방법은 이 링크를 클릭하세요" />
                    </Hyperlink>
                </Label>

                <CheckBox 
                    Name="cbTaskbar"
                    Content="작업 표시줄 아이콘 숨기기"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"
                    Margin="20,10,0,3"
                    Checked="cbTaskbar_Checked"
                    Unchecked="cbTaskbar_Unchecked"
                    />
                <TextBlock 
                    Text="*참고: 작업 표시줄 아이콘을 숨기면 앱 메뉴를 열기 위해 트레이 아이콘을 사용해야 합니다."
                    FontStyle="Italic"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"
                    Margin="40,0"/>

                <CheckBox 
                    Visibility="Visible"
                    Name="cbMultiInstance"
                    Content="다중 실행 허용 (베타)"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"
                    Margin="20,10,0,0"
                    Checked="cbMultiInstance_Checked"
                    Unchecked="cbMultiInstance_Unchecked"
                    />

                <Rectangle Height="2" Fill="Gray" Margin="10 5 25 5" />

                <Label Margin="15,5,0,0" HorizontalAlignment="Left" Content="전역 단축키" FontWeight="Bold" />
                <Label Margin="15,5,0,0" HorizontalAlignment="Left" FontStyle="Italic" Content="단축키를 해제하려면 '단축키 캡처'를 클릭한 뒤 Esc, Delete, 또는 Backspace를 누르세요" />
                <Label Margin="15,5,0,0" HorizontalAlignment="Left" FontStyle="Italic" Content="단축키는 전역으로 작동하므로 조합 키(Ctrl, Alt 등)를 사용하는 것을 권장합니다" />
                <Label Margin="15,5,0,0" HorizontalAlignment="Left" FontStyle="Italic" Content="그렇지 않으면 다른 앱에서 해당 키를 사용할 수 없게 됩니다!" />

                <Label Margin="15,15,0,0" HorizontalAlignment="Left" Content="테두리 전환 단축키"  />
                <StackPanel Orientation="Horizontal">
                    <ttc:HotkeyEditorControl x:Name="hotkeyInputToggleBorders" Margin="15,5,0,0" Width="250" HorizontalAlignment="Left" />
                    <Button Margin="15,5,0,0" Name="btCaptureHotkeyToggleBorders" Content="단축키 캡처" Click="setHotkeyToggleBorders_Click" />
                </StackPanel>

                <Label Content="클릭 투과 전환 단축키" Margin="15,15,0,0" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal">
                    <ttc:HotkeyEditorControl x:Name="hotkeyInputToggleInteractable" Margin="15,5,0,0" Width="250" HorizontalAlignment="Left" />
                    <Button Margin="15,5,0,0" Name="btCaptureHotkeyInteractable" Content="단축키 캡처" Click="setHotkeyToggleInteractable_Click" />
                </StackPanel>

                <Label Margin="15,15,0,0" HorizontalAlignment="Left" Content="항상 위에 표시 단축키"  />
                <StackPanel Orientation="Horizontal">
                    <ttc:HotkeyEditorControl x:Name="hotkeyInputBringToTop" Margin="15,5,0,0" Width="250" HorizontalAlignment="Left" />
                    <Button Margin="15,5,0,0" Name="btCaptureHotkeyBringToTop" Content="단축키 캡처" Click="setHotkeyBringToTop_Click" />
                </StackPanel>

                <Rectangle Height="2" Fill="Gray" Margin="10 15 25 5" />
                <Label Content="사운드 출력 장치" Margin="15,5,0,0" FontWeight="Bold"/>
                <ComboBox x:Name="DevicesComboBox" Margin="20,5,20,10" />
                <Label Content="효과음 볼륨" Margin="15,0,0,0" FontWeight="Bold"/>
                <Slider x:Name="OutputVolumeSlider" Value="100" IsSnapToTickEnabled="False" AutoToolTipPlacement="TopLeft" TickPlacement="BottomRight" TickFrequency="5" Minimum="0" Maximum="100" Margin="20,5,20,10" />
                <Label Content="효과음 폴더" Margin="15,0,0,0" FontWeight="Bold"/>
                <TextBlock Name="tbSoundClipsFolder" Margin="20,5,20,10" TextWrapping="WrapWithOverflow"  Text="Default" />
                <Button Name="btChangeSoundClipsFolder" Width="100" HorizontalAlignment="Left" Margin="20,5,20,0" Content="변경" Click="btChangeSoundClipsFolder_Click" />
                <Button Name="btDefaultSoundClipsFolder" Width="100" HorizontalAlignment="Left" Margin="20,5,20,10" Content="초기화" Click="btDefaultSoundClipsFolder_Click" />
                <CheckBox Visibility="Hidden" Name="cbPlayRandom" Margin="20,5,20,10" Content="폴더에서 무작위 클립 재생" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
