<UserControl x:Class="TransparentTwitchChatWPF.View.Settings.ChatSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TransparentTwitchChatWPF.View.Settings"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             ui:ThemeManager.RequestedTheme="Dark"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Name="chatGrid" Visibility="Visible" Grid.Row="0">
        <Grid Name="twitchPopoutChat" Visibility="Hidden">
            <DockPanel Margin="10">
                <ui:SimpleStackPanel DockPanel.Dock="Top" Margin="10" Spacing="5">
                    <Label Content="사용자 이름" HorizontalAlignment="Left" FontWeight="Bold"/>
                    <TextBox Name="tbTwitchPopoutUsername" HorizontalAlignment="Left" Height="23" Width="240" TextWrapping="NoWrap" Text="username" VerticalAlignment="Top" />
                    <Label Content="확장 기능" HorizontalAlignment="Left" FontWeight="Bold"/>
                    <CheckBox Name="cbBetterTtv" Content="BetterTTV 활성화" HorizontalAlignment="Left" />
                    <CheckBox Name="cbBetterTtv_AdvMenu" Content="BTTV 고급 이모티콘 메뉴 활성화" HorizontalAlignment="Left" />
                    <CheckBox Name="cbBetterTtv_7tv" Content="7TV 이모티콘 활성화" HorizontalAlignment="Left" />
                    <CheckBox Name="cbFfz" Content="FrankerFaceZ 활성화" HorizontalAlignment="Left" />
                    <Label Content="사용자 지정 CSS" HorizontalAlignment="Left" FontWeight="Bold" />
                    <CheckBox Name="cbUseDefaultPopoutCSS" 
                              Content="기본값 사용 (CSS를 편집하려면 체크 해제)" 
                              HorizontalAlignment="Left" 
                              Checked="cbUseDefaultPopoutCSS_Checked"
                              Unchecked="cbUseDefaultPopoutCSS_Unchecked" />
                </ui:SimpleStackPanel>

                <avalonedit:TextEditor Name="tbPopoutCSS" 
                    BorderBrush="LightSlateGray"
                    BorderThickness="1"
                    Background="#AAA"
                    Padding="5,5,0,0"
                    Margin="5,0,5,5"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" 
                    WordWrap="False"
                    Text="" />
            </DockPanel>
        </Grid>
        
        <Grid Name="customURLGrid" Visibility="Hidden" Grid.Column="1">
            <Label Content="URL" HorizontalAlignment="Left" Margin="12,15,0,0" FontWeight="Bold" />
            <TextBox Name="tbURL" HorizontalAlignment="Stretch" Height="23" Width="Auto" Margin="20,40,15,0" TextWrapping="NoWrap" Text="url" VerticalAlignment="Top" />

            <Label Content="사용자 지정 CSS" HorizontalAlignment="Left" Margin="12,80,0,0" FontWeight="Bold" />
            <avalonedit:TextEditor Name="tbCSS2" 
                 BorderBrush="LightSlateGray"
                 BorderThickness="1"
                 Background="#AAA"
                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                 Width="Auto" Height="Auto"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" 
                 Margin="22,100,15,50" WordWrap="False"
                 Text="body { background-color: rgba(0, 0, 0, 0); margin: 0px auto; overflow: hidden; }" />
        </Grid>
        <Grid Name="kapChatGrid" Visibility="Hidden" Grid.Column="1">
            <StackPanel HorizontalAlignment="Left" Orientation="Vertical" Width="127">
                <Label Content="사용자 이름" HorizontalAlignment="Left" Margin="20,33,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
                <Label Content="포인트 보상" HorizontalAlignment="Left" Margin="20,20,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
                <Label Content="Twitch" HorizontalAlignment="Left" Margin="20,20,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
                <Label Content="채팅 페이드" HorizontalAlignment="Left" Margin="20,25,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
                <Label Content="채팅 페이드 시간" HorizontalAlignment="Left" Margin="20,35,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
                <Label Content="필터 설정" HorizontalAlignment="Left" Margin="20,25,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
                <Label Content="채팅 알림음" HorizontalAlignment="Left" Margin="20,35,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
                <Label Content="테마" HorizontalAlignment="Left" Margin="20,35,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
                <Label Name="lblCSS" Content="사용자 지정 CSS" Visibility="Hidden" HorizontalAlignment="Left" Margin="20,25,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Orientation="Vertical" Width="274">
                <TextBox Name="tbUsername" HorizontalAlignment="Left" Height="23" Margin="20,27,0,0" TextWrapping="NoWrap" Text="username" VerticalAlignment="Top" Width="240"/>
                <CheckBox Name="cbRedemptions" Content="채널 포인트 보상 표시" Margin="20,12,0,0" Checked="cbRedemptions_Checked" Unchecked="cbRedemptions_Unchecked" />
                <StackPanel Orientation="Horizontal">
                    <Label Name="lblTwitchConnected" Margin="20,10,0,0" Content="..." Foreground="Gray" FontWeight="Bold" />
                    <Button Visibility="Hidden" Name="btGetChannelID" Margin="5,10,0,0" Content="Twitch 연결" Height="26" Width="100" FontSize="12" Click="btGetChannelID_Click" />
                </StackPanel>

                <CheckBox Name="cbFade" Margin="20,12,0,0" Content="오래된 채팅 메시지 서서히 숨기기" Checked="cbFade_Checked" Unchecked="cbFade_Unchecked" />
                <TextBox Name="tbFadeTime" IsEnabled="False" HorizontalAlignment="Left" Height="23" Margin="20,22,0,0" TextWrapping="NoWrap" Text="120" VerticalAlignment="Top" Width="240"/>
                <!--<CheckBox Name="cbBotActivity" Margin="20,22,0,0" Content="Enable to show bot activity in your chat" />-->
                <Button Name="btOpenChatFilterSettings" Margin="20,18,14,0" Content="채팅 필터 설정 열기" Height="32" Click="btOpenChatFilterSettings_Click" />
                <ComboBox Name="comboChatSound" SelectedValuePath="Content" Margin="20,20,14,0" DropDownClosed="comboChatSound_DropDownClosed" />

                <ComboBox Name="comboTheme" Margin="20,20,14,0" SelectionChanged="comboTheme_SelectionChanged">
                    <ComboBoxItem Content="없음 (사용자 지정 CSS)" />
                    <ComboBoxItem Content="BetterTTV's &quot;Black Chat&quot;" />
                    <ComboBoxItem Content="BetterTTV Dark" />
                    <ComboBoxItem Content="BetterTTV Light" />
                    <ComboBoxItem Content="Dark" />
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="S0N0S' 1080P" />
                    <ComboBoxItem Content="S0N0S' 1440P" />
                </ComboBox>

                <TextBox Name="tbCSS" 
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         Height="90"
                         Visibility="Hidden"
                         HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" 
                         Margin="20,32,15,0" TextWrapping="Wrap" AcceptsReturn="true" 
                         Text="body { background-color: rgba(0, 0, 0, 0); margin: 0px auto; overflow: hidden; }" />
            </StackPanel>
        </Grid>
        <Grid Name="jChatGrid" Visibility="Visible"  Grid.Column="1">
            <StackPanel HorizontalAlignment="Left" Orientation="Vertical" Width="127">
                <Label Content="사용자 이름" HorizontalAlignment="Left" Margin="20,33,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
                <Label Content="포인트 보상" HorizontalAlignment="Left" Margin="20,50,0,0" FontWeight="Bold"/>
                <Label Content="Twitch" HorizontalAlignment="Left" Margin="20,20,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
                <Label Content="필터 설정" HorizontalAlignment="Left" Margin="20,25,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
                <Label Content="채팅 알림음" HorizontalAlignment="Left" Margin="20,35,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Orientation="Vertical" Width="274">
                <TextBox Name="tb_nativeChatUsername" 
                         HorizontalAlignment="Left" 
                         Height="23" 
                         Margin="20,27,0,0" 
                         TextWrapping="NoWrap" 
                         ui:ControlHelper.PlaceholderText="사용자 이름"
                         VerticalAlignment="Top" 
                         Width="240"/>
                <ui:HyperlinkButton Click="HyperlinkButtonAppearanceSettings_Click">
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <ui:SymbolIcon Symbol="Link"/>
                        <TextBlock Text="모양 설정으로 이동"/>
                    </ui:SimpleStackPanel>
                </ui:HyperlinkButton>
                <CheckBox Name="cbRedemptions2" Content="채널 포인트 보상 표시" Margin="20,5,0,0" Checked="cbRedemptions_Checked" Unchecked="cbRedemptions_Unchecked" />
                <TextBox Visibility="Collapsed" Name="tbUsername2" HorizontalAlignment="Left" Height="23" Margin="20,5,0,0" TextWrapping="NoWrap" Text="username" VerticalAlignment="Top" Width="240"/>
                <StackPanel Orientation="Horizontal">
                    <Label Name="lblTwitchConnected2" Margin="20,10,0,0" Content="..." Foreground="Gray" FontWeight="Bold" />
                    <Button Visibility="Hidden" Name="btGetChannelID2" Margin="5,10,0,0" Content="Twitch 연결" Height="26" Width="100" FontSize="12" Click="btGetChannelID_Click" />
                </StackPanel>
                <Button Name="btOpenChatFilterSettings2" Margin="20,18,14,0" Content="채팅 필터 설정 열기" Height="32" Click="btOpenChatFilterSettings_Click" />
                <ComboBox Name="comboChatSound2" SelectedValuePath="Content" Margin="20,20,14,0" DropDownClosed="comboChatSound_DropDownClosed2" />
                <Rectangle Height="1" Fill="Gray" Margin="20,15,14,0" />
                <TextBlock Text="모든 NativeChat 오버레이 파일을 기본 제공 상태로 복원합니다. 채팅 화면이 깨지거나 파일이 삭제된 경우 사용하세요."
                           TextWrapping="Wrap" FontStyle="Italic" FontSize="11"
                           Margin="20,8,14,0" Foreground="Gray" />
                <Button Name="btRestoreNativeChatDefaults"
                        Content="기본 채팅 파일 복원"
                        Margin="20,8,0,0"
                        Width="200"
                        HorizontalAlignment="Left"
                        Click="btRestoreNativeChatDefaults_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
