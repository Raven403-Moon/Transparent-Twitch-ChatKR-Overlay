<Window x:Class="TransparentTwitchChatWPF.GetID_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TransparentTwitchChatWPF"
        mc:Ignorable="d"
        Title="채널 ID 가져오기" Height="330" Width="305" WindowStyle="ToolWindow" Topmost="True" WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel Orientation="Vertical">
            <Label Content="액세스 토큰:" />
            <TextBox Name="tbAccessToken" Height="23" Margin="5,0,0,0" TextWrapping="NoWrap" Text="" VerticalAlignment="Top" Width="240" />
            <Label Content="클라이언트 ID:" />
            <TextBox Name="tbClientID" Height="23" Margin="5,0,0,0" TextWrapping="NoWrap" Text="" VerticalAlignment="Top" Width="240" />
            <Label Name="lblChannelID" Content="채널 ID:" />
            <TextBox Name="tbChannelID" IsEnabled="false" Height="23" Margin="5,0,0,0" TextWrapping="NoWrap" Text="(여기에 ID가 표시됩니다)" VerticalAlignment="Top" Width="240" />
            <StackPanel Orientation="Horizontal">
                <Button Name="btnFetchID" Content="ID 가져오기" Width="90" Margin="25,10,0,0" Click="btnFetchID_Click" />
                <Button Name="btnCancel" Content="취소" Width="90" Margin="60,10,0,0" Click="btnCancel_Click" />
            </StackPanel>

            <TextBlock Margin="10,10,0,0" Text="토큰과 클라이언트 ID를 생성하려면 다음 사이트로 이동하세요:" />
            <Label Margin="5,0,0,0">
                <Hyperlink NavigateUri="https://twitchtokengenerator.com/" RequestNavigate="Hyperlink_RequestNavigate">
                    <TextBlock Text="https://twitchtokengenerator.com" />
                </Hyperlink>
            </Label>
            <TextBlock Margin="10,5,0,0" Text="(설정 방법을 잘 모르는 경우 'Bot Chat Token'을 클릭하세요)" FontSize="11" />
            <TextBlock Margin="10,5,0,0" Text="또한 나중에 사용할 수 있도록 토큰을 저장해 둘 수 있습니다" FontSize="11" />
            <TextBlock Margin="10,0,0,0" Text="단, 안전하게 보관하고 다른 사람과 공유하지 마세요!" FontSize="11" />

        </StackPanel>
    </Grid>
</Window>
