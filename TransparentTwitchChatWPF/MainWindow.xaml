<Window x:Class="TransparentTwitchChatWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:TransparentTwitchChatWPF"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:ThemeManager.RequestedTheme="Dark"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        ui:TitleBar.Style="{DynamicResource AppTitleBarStyle}"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        BorderBrush="Transparent"
        BorderThickness="4"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        Icon="/icons/twitch_chat2.ico"
        Title="" Height="530" Width="360" Closed="Window_Closed" Deactivated="Window_Deactivated" PreviewLostKeyboardFocus="Window_PreviewLostKeyboardFocus" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="AppTitleBarStyle" TargetType="ui:TitleBarControl">
            <Setter Property="ui:ThemeManager.RequestedTheme" Value="Dark" />
        </Style>
    </Window.Resources>

    <Grid>

        <Grid Name="mainWindowGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="18"/>
            </Grid.RowDefinitions>

            <tb:TaskbarIcon
                Name="taskbarControl"
                IconSource="/icons/twitch_chat2.ico"
                ToolTipText="Transparent-Twitch-ChatKR-Overlay">

                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu ui:ThemeManager.RequestedTheme="Dark" x:Name="contextMenu">
                        <MenuItem Header="Transparent-Twitch-ChatKR-Overlay" IsEnabled="False" />
                        <MenuItem Header="테두리 숨기기/표시" Click="MenuItem_ToggleBorderVisible" />
                        <MenuItem Header="클릭 투과 전환" Click="MenuItem_ToggleInteractable" />
                        <MenuItem Header="항상 위에 표시" Click="MenuItem_BringToTopTimer" />
                        <Separator />
                        <MenuItem Header="개발자 도구" Click="MenuItem_DevToolsClick" />
                        <MenuItem Header="설정" Click="MenuItem_SettingsClick" />
                        <Separator />
                        <MenuItem Header="창 위치/크기 초기화" Click="MenuItem_ResetWindowClick" />
                        <Separator />
                        <MenuItem Header="업데이트 확인" Click="MenuItem_CheckForUpdates" />
                        <MenuItem Header="GitHub 최신 릴리스" Click="MenuItem_VisitWebsite" />
                        <MenuItem Header="종료" Click="MenuItem_Exit" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>

            <Grid x:Name="AppTitleBar"
                  Background="#000"
                  ui:ThemeManager.RequestedTheme="Dark">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:SimpleStackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:TitleBarButton
                        x:Name="btnSettings"
                        MouseRightButtonUp="btnSettings_MouseRightButtonUp"
                        Click="btnSettings_Click">
                        <ui:TitleBarButton.ContextMenu>
                            <ContextMenu x:Name="settingsBtnContextMenu" ui:ThemeManager.RequestedTheme="Dark">
                                <MenuItem Header="Transparent-Twitch-ChatKR-Overlay" IsEnabled="False" />
                                <MenuItem x:Name="menuItemToggleBorders" Header="테두리 전환" Click="MenuItem_ToggleBorderVisible" />
                                <MenuItem Header="새 위젯" Click="MenuItem_ClickNewWindow" />
                                <MenuItem Header="확대/축소 배율">
                                    <MenuItem Header="+ 확대" Click="MenuItem_ZoomIn" StaysOpenOnClick="True" />
                                    <MenuItem Header="- 축소" Click="MenuItem_ZoomOut" StaysOpenOnClick="True" />
                                    <MenuItem Header="초기화" Click="MenuItem_ZoomReset" />
                                </MenuItem>
                                <MenuItem Header="불투명도">
                                    <MenuItem Header="+ 증가" Click="MenuItem_IncOpacity" StaysOpenOnClick="True" />
                                    <MenuItem Header="- 감소" Click="MenuItem_DecOpacity" StaysOpenOnClick="True" />
                                    <MenuItem Header="초기화" Click="MenuItem_ResetOpacity" />
                                </MenuItem>
                                <MenuItem Header="설정" Click="MenuItem_ShowSettings" />
                                <MenuItem Header="개발자 도구" Click="MenuItem_DevToolsClick" />
                                <Separator />
                                <MenuItem x:Name="menuItemToggleInteractable" Header="클릭 투과 전환" Click="MenuItem_ToggleInteractable" />
                                <MenuItem x:Name="menuItemBringToTop" Header="항상 위에 표시" Click="MenuItem_BringToTopTimer" />
                                <Separator />
                                <MenuItem Header="GitHub 최신 릴리스" Click="MenuItem_VisitWebsite" />
                                <MenuItem Header="업데이트 확인" Click="MenuItem_CheckForUpdates" />
                            </ContextMenu>
                        </ui:TitleBarButton.ContextMenu>
                        <Grid>
                            <Line X1="1" Y1="1" X2="18" Y2="1" Stroke="White" StrokeThickness="2" />
                            <Line X1="1" Y1="7" X2="18" Y2="7" Stroke="White" StrokeThickness="2" />
                            <Line X1="1" Y1="13" X2="18" Y2="13" Stroke="White" StrokeThickness="2" />
                        </Grid>
                    </ui:TitleBarButton>
                    <ui:TitleBarButton
                        x:Name="btnHide"
                        Click="btnHide_Click">
                        <Grid>
                            <Ellipse
                            Margin="0"
                            Width="16"
                            Height="16"
                            Fill="Transparent"
                            Stroke="White"
                            StrokeThickness="2" />
                            <Line X1="1" Y1="1" X2="17" Y2="17" Stroke="White" StrokeThickness="2" />
                        </Grid>
                    </ui:TitleBarButton>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="10,0,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White" />
                </ui:SimpleStackPanel>
            </Grid>

            <Border Grid.Row="1" Name="overlay" Background="black" Opacity="0.01" Panel.ZIndex="1"/>
            <Border Name="FooterBar" Grid.Row="3" Opacity="0.1" Panel.ZIndex="2" Background="Black" />

            <Grid x:Name="PlaceholderOverlay" Background="#80000000" Visibility="Collapsed">
                <Border HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Background="#FF2D2D30"
                        CornerRadius="8"
                        MaxWidth="400"
                        Padding="25">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="15" Opacity="0.5" Color="Black"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="추가 구성 요소 필요"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="PlaceHolderOverlayText"
                                   Text="웹 콘텐츠를 표시하려면 Microsoft의 무료 WebView2 런타임이 필요합니다. 설치 후 앱이 자동으로 새로고침됩니다."
                                   Foreground="#DDFFFFFF"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,15,0,25"
                                   TextAlignment="Center"/>

                        <Button x:Name="InstallButton"
                                Content="다운로드 및 설치"
                                Click="InstallButton_Click"
                                HorizontalAlignment="Center"
                                FontSize="15"
                                FontWeight="Medium"
                                Background="#FF0078D4"
                                Foreground="White"
                                Padding="20,10"
                                BorderThickness="0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
