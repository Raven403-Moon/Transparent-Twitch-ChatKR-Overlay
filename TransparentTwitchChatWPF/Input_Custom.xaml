<Window x:Class="TransparentTwitchChatWPF.Input_Custom"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:TransparentTwitchChatWPF"
        mc:Ignorable="d"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:ThemeManager.RequestedTheme="Dark"
        WindowStyle="ToolWindow"
        Topmost="True"
        Width="420"
        Height="485"
        Background="#1A1A1A"
        Title="사용자 지정 URL 입력" SizeToContent="Manual" WindowStartupLocation="CenterScreen" ContentRendered="Window_ContentRendered">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- <Image Source="/WpfTutorialSamples;component/Images/question32.png" Width="32" Height="32" Grid.RowSpan="2" Margin="20,0" /> -->

        <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch">
            <Label Name="lblName">표시 이름:</Label>
            <TextBox Name="txtName" MinWidth="250"></TextBox>
            <Label Name="lblQuestion">사용자 지정 URL:</Label>
            <TextBox Name="txtUrl" MinWidth="250"></TextBox>
            <TextBlock 
                    Margin="0,10,0,0" 
                    FontStyle="Italic" 
                    TextWrapping="Wrap"
                    Text="테두리가 보일 때 로그인 버튼이나 쿠키 팝업 등의 웹사이트 콘텐츠를 클릭할 수 있도록 허용합니다. 이 설정은 나중에 변경할 수 있습니다." 
                    />
            <CheckBox Content="클릭 상호작용 허용" Name="cbAllowInteraction" />

            <Label Margin="0,10,0,0">사용자 지정 CSS:</Label>
        </StackPanel>
        <avalonedit:TextEditor Name="tbCustomCSS"
                Grid.Row="1" Grid.ColumnSpan="2"
                Background="#AAA"
                BorderBrush="LightSlateGray"
                BorderThickness="1"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                MinHeight="150"
                HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" 
                Margin="0" WordWrap="False"
                Text="body { background-color: rgba(0, 0, 0, 0); }" />

            <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button IsDefault="True" Name="btnDialogOk" Click="btnDialogOk_Click" MinWidth="60" Margin="0,0,10,0">확인(_O)</Button>
            <Button IsCancel="True" MinWidth="60">취소(_C)</Button>
        </WrapPanel>
    </Grid>
</Window>
